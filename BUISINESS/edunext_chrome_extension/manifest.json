{
  "manifest_version": 3,
  "name": "FPT EduNext AI Assistant Pro",
  "version": "10.1.6",
  "description": "Trợ lý học tập thông minh tự giải bài tập, tự chọn Làm Rõ Ý Định, chống 429 Rate Limit trên FPT EduNext LMS. Độc lập 100% không cần Tampermonkey.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://fsc-edunext.fpt.edu.vn/*",
        "*://*.fpt.edu.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "FPT EduNext Assistant Pro v10.1.6"
  }
}