# GEMINI_API_KEY: Server-only Gemini key used by AI counseling features.
# Configure it in your server/Vercel environment; do not expose it with a VITE_ prefix.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server-only DeepSeek key for selected-school official-source search and analysis.
# The secret names DAMINFINITE, DAMINFINiTE, and DEEPSEEK_API_KEY are supported.
# Keep the key on the server; do not expose it with a VITE_ prefix.
DAMINFINITE="MY_DEEPSEEK_API_KEY"

# GROQ_API_KEY is used by separate chat/vision features, not the admissions analysis endpoint.
GROQ_API_KEY=""

# Optional model overrides.
DEEPSEEK_ADMISSIONS_MODEL=deepseek-flash

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
