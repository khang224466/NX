# Server-only keys for on-demand admissions lookup.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional server-side Gemini failover keys; tried after GEMINI_API_KEY on 401/403/429.
# DAM11, Dam10, DAM9, DAM8, DAM7, DAM1, DAM2, DAM (numeric aliases sort high-to-low).

# Optional model overrides.
GEMINI_ADMISSIONS_MODEL=gemini-3.5-flash-lite
GROQ_ADMISSIONS_MODEL=openai/gpt-oss-20b

# Optional deployment URL used by other server-side modules.
APP_URL=
