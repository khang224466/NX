# GEMINI_API_KEY: Required for other server-side Gemini features.
# Configure it in your server/Vercel environment; do not expose it with a VITE_ prefix.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPSEEK_API_KEY: Required for selected-school official-source search and analysis.
# Keep this secret on the server; do not expose it with a VITE_ prefix.
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
