# Server-only Gemini key used by the separate chat counselor flow.
GEMINI_API_KEY=
# The /api/ai/counselor/analyze endpoint uses DeepSeek; its response is mapped directly into the website data.
DAMINFINITE=
# GROQ_API_KEY is used by separate chat/vision features, not the admissions analysis endpoint.
GROQ_API_KEY=

# Optional model overrides.
DEEPSEEK_ADMISSIONS_MODEL=deepseek-flash

# Optional deployment URL used by other server-side modules.
APP_URL=
