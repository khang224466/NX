# Server-only Gemini key used by the separate chat counselor flow.
GEMINI_API_KEY=
# The /api/ai/counselor/analyze endpoint uses DeepSeek for profile analysis.
DAMINFINITE=
# Groq formats DeepSeek's analysis into the response shape used by the website.
GROQ_API_KEY=
# Existing Vercel Groq key aliases are also supported as failover keys: DAM9, DAM8, DAM7, DAM.

# Optional model overrides.
DEEPSEEK_ADMISSIONS_MODEL=deepseek-flash
GROQ_ADMISSIONS_MODEL=openai/gpt-oss-20b

# Optional deployment URL used by other server-side modules.
APP_URL=
