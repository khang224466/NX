      {
        "id": "C02",
        "dimension": "C",
        "text": "Kiểm toán, rà soát chứng từ chi tiêu để ngăn ngừa gian lận sai sót"
      },
      {
        "id": "C03",
        "dimension": "C",
        "text": "Thiết lập quy trình quản lý hồ sơ tài liệu lưu trữ khoa học, chuẩn mực"
      },
      {
        "id": "C04",
        "dimension": "C",
        "text": "Thực hiện tính toán lương, phụ cấp và các khoản trích theo lương chính xác"
      },
      {
        "id": "C05",
        "dimension": "C",
        "text": "Rà soát tính chuẩn xác của các điều khoản văn bản theo quy định pháp luật"
      },
      {
        "id": "C06",
        "dimension": "C",
        "text": "Kiểm kê định kỳ tài sản, hàng hóa trong kho theo hệ thống mã vạch"
