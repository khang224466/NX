      {
        "id": "E06",
        "dimension": "E",
        "text": "Thuyết trình dự án và bảo vệ quan điểm trước hội đồng đầu tư"
      },
      {
        "id": "E07",
        "dimension": "E",
        "text": "Theo dõi các chỉ số tài chính, tối ưu hóa lợi nhuận kinh doanh"
